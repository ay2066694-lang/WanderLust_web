<% layout("/layout/boilerplate.ejs") %>

    <style>
        #filter {
            display: flex !important;
            flex-wrap: nowrap !important;
            align-items: center;
            gap: 2rem;
            text-align: center;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
        }

        #filter::-webkit-scrollbar {
            display: none;
        }

        .filter-item {
            opacity: 0.7;
            margin-top: 1rem;
            margin-bottom: 1rem;
            flex-shrink: 0;
        }

        .filter-item:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter-item p {
            font-size: 0.9rem;
            margin-bottom: 0;
        }

        .text-info {
            display: none;
        }

        /* Toggle box */
        .text-swtich {
            border: 1px solid black;
            padding: 0.40rem 0.90rem;
            border-radius: 0.50rem;
            display: flex;
            align-items: center;
            margin-left: auto;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .text-swtich .form-switch {
            margin: 0 !important;
            padding: 0 !important;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        /* Toggle */
        .text-swtich .form-check-input {
            margin: 0 !important;
            padding: 0 !important;
            float: none;
            flex-shrink: 0;
        }

        /* Text */
        .text-swtich .form-check-label {
            margin: 0 !important;
            padding: 0 !important;
        }
    </style>

    <div id="filter" class="flex-wrap align-items-center gap-4">
        <div class="filter-item">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-duotone fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-sharp fa-solid fa-mountain-city"></i></div>
            <p>Mountain-city</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Artic</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing Pools</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </div>
        <div class="filter-item">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </div>

        <div class="text-swtich ms-auto">
            <div class="form-switch">
                Display total after textes
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">
                </label>
            </div>
        </div>
    </div>

    <!-- <h1>All Listing</h1> -->
    <% if (search && allListing.length===0) { %>
        <div class="text-center mt-5">
            <h3>No listings found for "<%= search %>"</h3>
            <p>Try searching for another destination.</p>
        </div>
        <% } %>
            <div class="row row-cols-lg-3">
                <% for(let list of allListing) { %>
                    <a href="/listings/<%= list.id %>" class="listing-link">
                        <div class="card col card-listing">
                            <img src="<%=list.image.url%>" class="card-img-top" alt="listing_image">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="cart-text">
                                    <b>
                                        <%= list.title %>
                                    </b> <br>
                                    &#8377; <%= list.price ? list.price.toLocaleString("en-IN") : "Price not available"
                                        %> /
                                        Night<i class="text-info">&nbsp;&nbsp; +18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                    <%}%>
            </div>

            <script>
                let textSwitch = document.getElementById("switchCheckDefault");
                if (textSwitch) {
                    textSwitch.addEventListener("click", () => {
                        let textInfo = document.getElementsByClassName("text-info");
                        for (let info of textInfo) {
                            if (info.style.display != "inline") {
                                info.style.display = "inline";
                            } else {
                                info.style.display = "none";
                            }
                        }
                    });
                }
            </script>